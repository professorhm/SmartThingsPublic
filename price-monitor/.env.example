# Your Anthropologie email (pre-filled in the login browser window)
ANTH_EMAIL=your@email.com

# Where to send price drop alerts
NOTIFY_EMAIL=your@email.com

# Gmail account used to SEND the alert email
# Must have 2FA enabled and use an App Password (not your Gmail password)
# Get one at: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your_gmail@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Minimum price drop (in dollars) required to trigger an alert
# Prevents noise from tiny $0.01 fluctuations
PRICE_DROP_THRESHOLD=1.00

# Set to "false" to watch the browser window (useful for debugging)
HEADLESS=true
